server:
  port: 8080
  servlet:
    context-path: /sigte/api/v1

spring:
  application:
    name: sigte

  datasource:
    url: //localhost:5432/bd_sigte
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:tu_contrasena}
    driver-class-name: org.postgresql.Driver

  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  mail:
    host: ${MAIL_HOST:smtp.gmail.com}
    port: ${MAIL_PORT:587}
    username: ${MAIL_USERNAME:tu.correo@gmail.com}
    password: ${MAIL_PASSWORD:tu_app_password}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
            required: true
          connectiontimeout: 5000
          timeout: 5000
          writetimeout: 5000

  flyway:
    enabled: true
    schemas:
      - maestros
      - personas
      - tramites
    default-schema: maestros
    create-schemas: true
    locations: classpath:db/migration

  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 22MB

app:
  storage:
    location: ${STORAGE_LOCATION:./storage}

jodconverter:
  local:
    enabled: true
    office-home: ${LIBREOFFICE_HOME:/usr/lib/libreoffice}
    port-numbers: 2002
    task-execution-timeout: 120000
    process-timeout: 120000
    max-tasks-per-process: 500
    keep-alive-on-shutdown: true